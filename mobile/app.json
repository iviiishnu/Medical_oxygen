{
  "expo": {
    "name": "O2 Mobile Monitor",
    "slug": "o2-mobile-monitor",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow O2 Monitor to use the camera to read the oxygen panel."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow O2 Monitor to select a panel image for a reading."
        }
      ]
    ],
    "android": {
      "package": "org.o2monitor.mobile",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK"
      ],
      "usesCleartextTraffic": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.o2monitor.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to the local oxygen panel vision server for readings.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "extra": {
      "o2VisionPort": 8765,
      "eas": {
        "projectId": "9ed9d5e5-883b-48b4-8d9d-7dd56b65d980"
      }
    },
    "owner": "shadowemp"
  }
}
