{
  "name": "O2MobileMonitor",
  "main": "expo/AppEntry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node tools/start-dev.js",
    "start:dev": "node tools/start-dev.js --dev-client",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "start:tunnel": "node tools/start-dev.js --tunnel",
    "android": "node tools/start-dev.js --android",
    "ios": "node tools/start-dev.js --ios",
    "start:bare": "react-native start",
    "android:bare": "react-native run-android",
    "ios:bare": "react-native run-ios",
    "web": "node -e \"const http=require('http'),fs=require('fs');http.createServer((req,res)=>{fs.readFile('tester/index.html',(err,data)=>{res.writeHead(200,{'Content-Type':'text/html'});res.end(data);});}).listen(3000,()=>console.log('Mobile Tester running at http://localhost:3000'));\"",
    "test": "node --test --experimental-strip-types \"src/utils/*.test.ts\"",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.1.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "axios": "^1.7.9",
    "expo": "^58.0.0",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-image-picker": "~58.0.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keychain": "^8.2.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "^4.4.0",
    "react-native-svg": "15.16.0",
    "react-native-vision-camera": "^4.6.3",
    "react-native-webrtc": "^124.0.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^15.0.1",
    "@react-native-community/cli-platform-android": "^15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/react": "~19.3.0",
    "@types/react-native": "^0.73.0",
    "typescript": "~6.0.3"
  }
}
