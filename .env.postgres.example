# PostgreSQL-only local backend configuration. Copy to repository-root .env.
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://o2_monitor:change-this-local-password@127.0.0.1:5432/o2_monitor
# Replace with a random value of at least 32 characters. Used to sign short-lived login sessions.
AUTH_SECRET=replace-this-with-a-long-random-secret-value
# Optional public API base URL for an installed app. Never put DATABASE_URL in the app build.
O2_BACKEND_URL=
