{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://o2monitor.local/reading.schema.json",
  "title": "Gauge reading message (vision -> alert engine -> Firebase)",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "gauge_id", "ts", "value", "unit", "confidence", "lamp_state", "method_agree", "status"],
  "properties": {
    "device_id": {"type": "string", "minLength": 1},
    "gauge_id": {"type": "string", "minLength": 1},
    "ts": {"type": "string", "description": "ISO-8601 with offset, e.g. 2026-11-20T10:15:02+05:30"},
    "value": {"type": ["number", "null"], "description": "null when the needle could not be read"},
    "unit": {"type": "string", "enum": ["kg/cm2", "psi", "bar", "mmHg"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "lamp_state": {"type": "string", "enum": ["NORMAL", "LOW", "HIGH", "OFF", "CONFLICT", "UNKNOWN"],
                   "description": "OFF = no lamp lit, CONFLICT = more than one lit, UNKNOWN = no lamps calibrated"},
    "method_agree": {"type": "boolean"},
    "status": {"type": "string", "enum": ["OK", "LOW", "CRITICAL", "UNCERTAIN", "MONITORING_LOST"]}
  }
}
