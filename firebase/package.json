{
  "name": "o2-monitor-firebase",
  "private": true,
  "scripts": {
    "emulators": "firebase emulators:start --only firestore,functions,auth --project o2-monitor-demo",
    "test:rules": "firebase emulators:exec --only firestore --project o2-monitor-demo \"node --test test/rules.test.js\"",
    "test:e2e": "firebase emulators:exec --only firestore,functions,auth --project o2-monitor-demo \"node --test test/e2e.test.js\"",
    "deploy": "firebase deploy --only firestore,functions"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  }
}
